@@ -43,13 +43,9 @@
 coincide "${WOW}(close|jira[[:space:]]+fix-fields)([[:space:]]+[^;&|]*)?[[:space:]]--apply([[:space:]]|$)" \
   && bloquear "wow close / wow jira fix-fields con --apply escriben en Jira"
 
-# jira-kanban: jk create/push con --apply crean y modifican issues en Jira. Sin --apply son vista previa.
-JK="${INICIO}([^[:space:];&|]*python3?[^[:space:];&|]*[[:space:]]+)?([^[:space:];&|]*/)?(jtk|jk)(\.py)?[[:space:]]+"
-coincide "${JK}(create|push|assign)([[:space:]]+[^;&|]*)?[[:space:]]--apply([[:space:]]|$)" \
-  && bloquear "jtk create / jtk push / jtk assign con --apply escriben en Jira (jk es el nombre viejo)"
-
-# jk apply escribe en Jira lo que dice un plan guardado (jk plan solo lee y pasa). Lo corre el usuario en una ventana de
-# terminal aparte, donde escribe APRUEBO <n>: bajo `!` tampoco funciona porque no hay terminal interactiva.
+# jira-kanban (jtk, antes jk): create/push/assign con --apply y apply escriben en Jira, pero la guarda de jtk pide la
+# aprobación de una persona en una ventana nativa (botón «Apruebo <n>») o en una terminal. Por eso el agente puede
+# lanzarlos; lo que se bloquea son los rodeos que aprobarían por ella (abajo).
 bloquear_terminal() {
   cat >&2 <<EOF
 BLOQUEADO — $1.
@@ -59,7 +55,6 @@
 EOF
   exit 2
 }
-coincide "${JK}apply([[:space:]]|$)" && bloquear_terminal "jtk apply escribe en Jira lo que dice un plan guardado"
 
 # Rodeo que la guarda APRUEBO no ve: un pseudo-terminal que escribe la aprobación (tmux send-keys, expect, script, pty...).
 # Va aunque `jk apply` no esté al inicio del comando. Falso positivo asumido: un mensaje que nombre las dos cosas a la vez.
@@ -73,6 +68,12 @@
 if coincide "$APLICA_ESCRIBE" && coincide "$PTY"; then
   bloquear_terminal "jtk create / push / assign con --apply a través de un pseudo-terminal salta la aprobación de una persona"
 fi
+# Rodeo de la ventana: mandarle clics o teclas (osascript con System Events, cliclick, peekaboo) para «aprobar» por la persona.
+# Va SIEMPRE, no solo junto a `jtk apply`: se puede lanzar el apply en un comando y apretar el botón en el siguiente.
+# Es una segunda capa (no ve scripts en archivos, Quartz, pyautogui...); la defensa de fondo es no darle permiso de
+# accesibilidad a la herramienta que corre al agente.
+UI='(osascript[^;&|]*(System Events|click|keystroke|key code|AXPress|perform action)|(^|[^[:alnum:]_])(cliclick|peekaboo)([[:space:]]|$))'
+coincide "$UI" && bloquear "automatizar clics o teclas sobre la ventana de aprobación salta la aprobación de una persona"
 # La otra mitad del mismo rodeo, en dos pasos: abrir la sesión por un lado y escribir la aprobación por el otro.
 coincide "tmux[[:space:]]+send(-keys)?[[:space:]].*APRUEBO" \
   && bloquear_terminal "escribir APRUEBO en una sesión tmux salta la aprobación de una persona"
